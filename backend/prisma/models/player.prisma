model Player {
  id          String    @id @default(cuid())
  name        String
  birthDate   DateTime?
  nationality String?
  position    Position
  photoUrl      String?
  height        Float?
  weight        Float?
  preferredFoot PreferredFoot?

  seasons          PlayerSeason[]
  shortlistEntries ShortlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("players")
}
