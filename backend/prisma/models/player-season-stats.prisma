/// Aggregated stats for a player across a single season.
/// Derived metrics (matches per card, skillful foot scores) are computed at
/// runtime in the service layer and intentionally not persisted.
model PlayerSeasonStats {
  id String @id @default(cuid())

  playerSeasonId String       @unique
  playerSeason   PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)

  matchesPlayed Int @default(0)
  minutesPlayed Int @default(0)
  goals         Int @default(0)
  assists       Int @default(0)
  yellowCards   Int @default(0)
  redCards      Int @default(0)

  /// DRI - Dribbling
  dribblesAttempted     Int?
  dribbleSuccessPct     Float?
  progressiveCarries    Int?
  carriesIntoFinalThird Int?
  ballRetentionPct      Float?
  foulsWon              Int?

  /// VEL - Pace
  topSpeed        Float?
  sprintDistance  Int?
  accelerations   Int?
  progressiveRuns Int?
  distanceCovered Float?

  /// PAS - Passing
  passAccuracyPct         Float?
  progressivePasses       Int?
  keyPasses               Int?
  throughBalls            Int?
  crossAccuracyPct        Float?
  xA                      Float?
  weakFootPassPct         Float?
  weakFootPassAccuracyPct Float?
  progressiveWfPasses     Int?

  /// TIR - Shooting
  goalsPer90              Float?
  xGPer90                 Float?
  shotAccuracyPct         Float?
  conversionRatePct       Float?
  shotsOnTarget           Int?
  touchesInBox            Int?
  weakFootShotPct         Float?
  weakFootGoals           Int?
  weakFootShotAccuracyPct Float?

  /// DEF - Defending
  tacklesWonPct     Float?
  interceptions     Int?
  recoveries        Int?
  blocks            Int?
  aerialDuelsWonPct Float?
  clearances        Int?

  /// FZA - Physical
  physicalDuelsWonPct   Float?
  strengthDuels         Int?
  balance               Float?
  stamina               Float?
  bodyContactSuccessPct Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_season_stats")
}
