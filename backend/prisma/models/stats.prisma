model Stats {
  id                  String @id @default(cuid())

  playerSeasonId String @unique

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)

  matchesPlayed Int   @default(0)
  minutesPlayed Int   @default(0)
  goals         Int   @default(0)
  assists       Int   @default(0)
  yellowCards   Int   @default(0)
  redCards      Int   @default(0)
  matchesPerYellowCard Float?
  matchesPerRedCard    Float?

  // DRI — DRIBBLING
  dribblesAttempted     Int?
  dribbleSuccessPct     Float?
  progressiveCarries    Int?
  carriesIntoFinalThird Int?
  ballRetentionPct      Float?
  foulsWon              Int?

  // VEL — PACE
  topSpeed        Float? // km/h
  sprintDistance  Int?   // metros
  accelerations   Int?
  progressiveRuns Int?
  distanceCovered Float? // km

  // PAS — PASSING
  passAccuracyPct         Float?
  progressivePasses       Int?
  keyPasses               Int?
  throughBalls            Int?
  crossAccuracyPct        Float?
  xA                      Float? // Expected Assists
  weakFootPassPct         Float?
  weakFootPassAccuracyPct Float?
  progressiveWfPasses     Int?
  skillfulFootPassScore   Float?

  // TIR — SHOOTING
  goalsPer90              Float?
  xGPer90                 Float?
  shotAccuracyPct         Float?
  conversionRatePct       Float?
  shotsOnTarget           Int?
  touchesInBox            Int?
  weakFootShotPct         Float?
  weakFootGoals           Int?
  weakFootShotAccuracyPct Float?
  skillfulFootShotScore   Float?

  // DEF — DEFENDING
  tacklesWonPct     Float?
  interceptions     Int?
  recoveries        Int?
  blocks            Int?
  aerialDuelsWonPct Float?
  clearances        Int?

  // FZA — PHYSICAL
  physicalDuelsWonPct  Float?
  strengthDuels        Int?
  balance              Float? // Score
  stamina              Float? // Score
  bodyContactSuccessPct Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}
